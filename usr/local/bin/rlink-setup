*{box-sizing:border-box}body{margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,sans-serif;
background:#f3f3f1;color:#1a1a1a}main{max-width:560px;margin:0 auto;padding:20px 16px 40px}
h1{font-size:22px;margin:4px 0 14px}.err{background:#fde8e6;border-left:4px solid #e2341d;padding:10px 12px;margin:12px 0}
.ok{background:#e7f3e9;border-left:4px solid #2b8a3e;padding:10px 12px;margin:12px 0}
.net{display:flex;align-items:center;gap:10px;padding:12px;border:1px solid #d6d6d2;background:#fff;margin:-1px 0 0}
.net input{width:20px;height:20px}.net span{flex:1;font-size:16px;word-break:break-all}.sig{color:#666;font-size:13px}
label.f{display:block;margin:16px 0 6px;font-weight:600}input[type=text],input[type=password]{width:100%;font-size:17px;padding:11px;border:1px solid #bbb}
