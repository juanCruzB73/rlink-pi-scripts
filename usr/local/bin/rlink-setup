button.sec{background:#fff;color:#1a1a1a;border:1px solid #bbb}.hint{color:#555;font-size:13px}
"""


def page(title, body, refresh=None):
    meta = f'<meta http-equiv="refresh" content="{refresh}">' if refresh else ""
    return (f'<!doctype html><html lang="es"><head><meta charset="utf-8">'
            f'<meta name="viewport" content="width=device-width,initial-scale=1">{meta}'
            f"<title>{html.escape(title)}</title><style>{STYLE}</style></head>"
            f"<body><main>{body}</main></body></html>")


def signal_label(pct):
    return "muy buena" if pct >= 70 else "buena" if pct >= 50 else "regular" if pct >= 30 else "débil"


def portal_page():
    s = state.public()
    if s["phase"] == "conectando":
        return page("Conectando", f'<h1>Conectando a «{html.escape(s["target"])}»…</h1>'
                    "<p>La Pi dejó de emitir su Wi-Fi para probar la red, así que este celular se va a "
                    "desconectar. Mirá la pantalla: si algo falla, la Pi vuelve a emitir y podés "
                    "reintentar.</p>", refresh=5)
    if s["phase"] == "listo":
        return page("Listo", '<h1>Listo</h1><div class="ok">La Pi quedó conectada. Ya podés cerrar esto.</div>')
    err = f'<div class="err">No se pudo conectar a {html.escape(s["error"])}. Probá de nuevo.</div>' if s["error"] else ""
    with state.lock:
        nets = list(state.networks)
    rows = "".join(
        f'<label class="net"><input type="radio" name="ssid" value="{html.escape(n["ssid"], quote=True)}"'
        f'{" checked" if i == 0 else ""}><span>{html.escape(n["ssid"])}{" 🔒" if n["secure"] else ""}</span>'
        f'<span class="sig">señal {signal_label(n["signal"])}</span></label>'
        for i, n in enumerate(nets)) or '<p class="hint">No se encontraron redes. Volvé a buscar o escribí el nombre abajo.</p>'
    body = f"""
<h1>Red Wi-Fi de {html.escape(s["host"])}</h1>{err}
<form method="post" action="/conectar">
  {rows}
  <label class="f" for="otra">¿No está en la lista? Nombre de la red</label>
  <input type="text" id="otra" name="otra" autocomplete="off" autocapitalize="none" placeholder="Solo si es una red oculta">
  <label class="f" for="clave">Clave</label>
  <input type="password" id="clave" name="clave" autocomplete="off" placeholder="Vacía si la red es abierta">
  <button type="submit">Conectar</button>
</form>
<form method="post" action="/buscar">
  <button class="sec" type="submit">Volver a buscar redes</button>
  <p class="hint">La Pi deja de emitir unos segundos: el celular se desconecta y hay que volver a unirse a
  {html.escape(s["ap_ssid"])}.</p>
</form>"""
    return page("Configurar red", body)


def qr_svg(text):
    rc, out = run(["qrencode", "-t", "SVG", "-m", "1", "-o", "-", text], timeout=10)
    return out[out.find("<svg"):] if rc == 0 and "<svg" in out else ""


def wifi_qr_text(ssid, psk):
    esc = lambda v: "".join("\\" + c if c in '\\;,:"' else c for c in v)
    return f"WIFI:T:WPA;S:{esc(ssid)};P:{esc(psk)};;"


def screen_page():
    s = state.public()
    ssid, psk = html.escape(s["ap_ssid"]), html.escape(s["ap_psk"])
    if s["phase"] == "listo":
        status = '<p class="big ok">Conectada. Arrancando la cartelería…</p>'
    elif s["phase"] == "conectando":
        status = f'<p class="big">Probando la red «{html.escape(s["target"])}»…</p>'
    elif s["phase"] == "buscando":
        status = '<p class="big">Buscando redes…</p>'
    else:
        status = ""
    err = f'<p class="big err">No se pudo conectar a {html.escape(s["error"])}. Probá de nuevo desde el celular.</p>' if s["error"] and s["phase"] == "esperando" else ""
    forced = ('<p class="small">Modo configuración forzado: si nadie configura nada en 15 minutos, la Pi vuelve '
              "sola a su red de siempre.</p>") if s["forced"] else ""
    steps = ""
    if s["phase"] == "esperando":
        steps = f"""
<div class="cols">
  <div class="qr">{qr_svg(wifi_qr_text(s["ap_ssid"], s["ap_psk"]))}</div>
  <ol>
    <li>Con el celular, escaneá el código con la cámara.<br><span class="small">O conectate a la red
      <b>{ssid}</b> con la clave <b class="mono">{psk}</b>.</span></li>
    <li>Se abre una página: elegí la red Wi-Fi del local y escribí su clave.<br><span class="small">Si no se
      abre sola, entrá a <b>http://{AP_IP}</b>.</span></li>
    <li>La pantalla va a decir si se pudo conectar.</li>
  </ol>
</div>"""
    css = """body{margin:0;background:#111;color:#f3f3f1;font-family:system-ui,sans-serif}
main{padding:5vh 6vw}h1{font-size:5vh;margin:0 0 3vh}.big{font-size:3.4vh}.small{font-size:2.3vh;color:#bbb}
.err{color:#ff8a7a}.ok{color:#8fdc9a}.cols{display:flex;gap:5vw;align-items:center}
.qr{background:#fff;padding:2vh;width:40vh;height:40vh;flex:none}.qr svg{width:100%;height:100%}
ol{font-size:3.2vh;line-height:1.45}li{margin-bottom:3vh}.mono{font-family:ui-monospace,monospace;letter-spacing:.15em}
.host{position:fixed;bottom:3vh;right:4vw;font-size:2vh;color:#888}"""
    script = f"""<script>
const v={s["version"]};setInterval(async()=>{{try{{const r=await fetch('/estado.json',{{cache:'no-store'}});
const j=await r.json();if(j.version!==v)location.reload()}}catch(e){{}}}},2000)</script>"""
    return (f'<!doctype html><html lang="es"><head><meta charset="utf-8"><title>Configuración de red</title>'
            f"<style>{css}</style></head><body><main><h1>Configuración de red</h1>{status}{err}{steps}{forced}"
            f'</main><div class="host">{html.escape(s["host"])}</div>{script}</body></html>')


class Handler(BaseHTTPRequestHandler):
    server_version = "rlink-setup"

    def log_message(self, fmt, *args):
        pass

    def from_phone(self):
        return self.client_address[0] not in ("127.0.0.1", "::1")

    def send(self, code, body, ctype="text/html; charset=utf-8", headers=None):
        data = body.encode("utf-8")
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        for k, v in (headers or {}).items():
            self.send_header(k, v)
        self.end_headers()
        self.wfile.write(data)

    def to_portal(self):
        # Cualquier URL que no sea del portal (las de prueba de Android e iOS incluidas) lleva al
        # portal: así el celular detecta que hay que "iniciar sesión" en esta red y lo abre solo.
        host = self.headers.get("Host", "")
        target = "/" if host.startswith(("localhost", "127.0.0.1")) or SIMULAR else f"http://{AP_IP}/"
        self.send(302, "", headers={"Location": target})

    def do_GET(self):
        path = urlparse(self.path).path
        if self.from_phone():
            state.last_activity = time.time()
        if path == "/pantalla":
            self.send(200, screen_page())
        elif path == "/estado.json":
            self.send(200, json.dumps(state.public()), "application/json")
        elif path == "/":
            self.send(200, portal_page())
        else:
            self.to_portal()

    def do_POST(self):
        path = urlparse(self.path).path
        length = min(int(self.headers.get("Content-Length") or 0), 4096)
        form = parse_qs(self.rfile.read(length).decode("utf-8", "replace"))
        state.last_activity = time.time()
        if path == "/conectar":
            ssid = (form.get("otra", [""])[0].strip() or form.get("ssid", [""])[0])
            psk = form.get("clave", [""])[0]
            if not ssid or len(ssid.encode()) > 32:
                state.update(error="(ninguna red): elegí una red de la lista o escribí su nombre")
            elif psk and not (8 <= len(psk) <= 63):
                state.update(error=f"{ssid}: la clave tiene que tener entre 8 y 63 caracteres")
            else:
                state.update(phase="conectando", target=ssid, error="")
                actions.put(("conectar", ssid, psk))
            self.send(303, "", headers={"Location": "/"})
        elif path == "/buscar":
            actions.put(("buscar",))
            self.send(200, page("Buscando", "<h1>Buscando redes…</h1><p>La Pi deja de emitir unos segundos. "
                                "Volvé a unirte a <b>" + html.escape(state.ap_ssid) + "</b> en un momento.</p>"))
        else:
            self.to_portal()


def serve():
    httpd = ThreadingHTTPServer(("0.0.0.0", PORT), Handler)
    httpd.daemon_threads = True
    threading.Thread(target=httpd.serve_forever, daemon=True).start()
    log(f"portal en el puerto {PORT}")
    return httpd


def setup_loop():
    """Escanear → emitir → esperar al celular. Termina cuando la Pi queda conectada."""
    log("ENTRANDO A setup_loop()")
    last_cable_check = time.time()
    while True:
        state.update(phase="buscando")
        hotspot_down()
        scan()
        if not hotspot_up():
            time.sleep(10)
            continue
        state.update(phase="esperando")
        while True:
            try:
                action = actions.get(timeout=5)
            except queue.Empty:
                action = None
            if action is None:
                if state.forced and time.time() - state.last_activity > FORCED_TIMEOUT:
                    leave_forced()
                    return
                if not state.forced and time.time() - last_cable_check > CABLE_CHECK_EVERY:
                    last_cable_check = time.time()
                    if not SIMULAR and server_ok(timeout=4):
                        hotspot_down()
                        finish("llega al servidor (cable)")
                        return
                continue
            if action[0] == "buscar":
                break  # vuelve a escanear y a emitir
            if action[0] == "conectar":
                _, ssid, psk = action
                log(f"probando la red elegida en el portal: {ssid}")
                hotspot_down()
                log(f"hotspot cerrado, conectando a {ssid}...")
                reason = connect(ssid, psk)
                log(f"resultado de connect(): {reason}")
                if reason is None:
                    log("LLAMANDO A finish()...")
                    finish(f"conectada a {ssid}")
                    log("finish() completó, saliendo de setup_loop()")
                    return
                log(f"error de conexión: {reason}")
                state.update(error=f"{ssid}: {MESSAGES[reason]}", target=ssid)
                break  # vuelve a emitir con el error a la vista


def cleanup(*_):
    if hotspot_active:
        hotspot_down()
    sys.exit(0)


def main():
    signal.signal(signal.SIGTERM, cleanup)
    if SIMULAR:
        log("SIMULACIÓN: no emite ni se conecta")
        state.update(forced=True)
        httpd = serve()
        scan()
        state.update(phase="esperando")
        while True:
            action = actions.get()
            if action[0] == "conectar":
                reason = connect(action[1], action[2])
                state.update(phase="listo" if reason is None else "esperando",
                             error="" if reason is None else f"{action[1]}: {MESSAGES[reason]}")
            else:
                scan()
                state.update(phase="esperando")

    forced = consume_force()
    configured = configured_networks()
    if not forced and configured:
        write_modo("kiosk")
        log(f"redes guardadas ({len(configured)}): kiosco")
        return
    write_modo("setup")
    # Con a dónde volver, forzarlo tiene límite de tiempo. Una Pi nueva espera sin límite.
    state.update(forced=forced and bool(configured))
    log("modo configuración " + ("(forzado)" if forced else "(sin redes guardadas)"))
    serve()
    try:
        if not forced and server_ok():
            finish("ya llega al servidor (cable)")
            return
        if try_wifi_file():
            finish("conectada con rlink-wifi.txt")
            return
        setup_loop()
    finally:
        if hotspot_active:
            hotspot_down()


if __name__ == "__main__":
    main()
