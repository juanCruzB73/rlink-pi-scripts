#!/usr/bin/env python3
# /usr/local/bin/rlink-setup — modo configuración de red (etapa 2 de docs/plan-redes-wifi.md)
#
# Lo arranca systemd (rlink-setup.service, root) en cada arranque. Decide el modo y lo deja en
# /run/rlink-setup/modo, que lee rlink-arranque (la sesión gráfica):
#   kiosk   la Pi tiene redes guardadas: no hace nada más y termina.
#   setup   la Pi nunca se configuró, o alguien lo forzó con el archivo rlink-setup en la
#           partición de arranque (/boot/firmware/rlink-setup, se puede crear desde Windows
#           poniendo la SD en la PC). El archivo se borra al leerlo: forzar vale un arranque.
#
# En modo configuración:
#   1. Si no está forzado, prueba si ya llega al servidor (cable enchufado).
#   2. Si hay /boot/firmware/rlink-wifi.txt (líneas "ssid=..." y "clave=..."), prueba esa red y
#      borra el archivo (tiene una clave).
#   3. Escanea las redes visibles. La Pi 4 tiene una sola radio: escanea antes de emitir.
#   4. Emite el Wi-Fi "Rlink-XXXX" con una clave al azar. La pantalla (rlink-arranque abre
#      http://localhost/pantalla) muestra nombre, clave y un QR para unirse con el celular.
#   5. El celular se une y el sistema operativo abre solo el portal (portal cautivo: el dnsmasq
#      de NetworkManager resuelve cualquier nombre a la Pi, y cualquier URL desconocida redirige
#      al portal). Ahí se elige la red y se escribe la clave.
#   6. Deja de emitir, se conecta y prueba llegar al servidor. Si anda, guarda la red y escribe
#      modo=kiosk: rlink-arranque cierra la pantalla de configuración y arranca kiosk.sh. Si no
#      anda, borra la red que creó, vuelve al paso 4 y muestra el motivo en la pantalla y en el
#      portal.
#
# Forzado con redes guardadas: si en 15 min nadie usa el portal, deja de emitir, NetworkManager
# vuelve solo a la red de siempre y la Pi sigue como kiosco. Así forzarlo a distancia nunca deja
# la Pi incomunicada. Sin redes guardadas (Pi nueva) espera sin límite, y cada 30 s se fija si
# apareció un cable.
#
# Log: journalctl -u rlink-setup, y /var/log/rlink-setup.log (sin claves).
#
# Probar el portal sin tocar la red (desde otra máquina, http://<ip-de-la-pi>:8080/):
#   sudo RLINK_SETUP_SIMULAR=1 RLINK_SETUP_PORT=8080 RLINK_SETUP_RUN=/tmp/rlink-setup-sim rlink-setup
# En simulación no emite, no se conecta a nada y no toca /run/rlink-setup. La clave "malaclave"
# simula una clave incorrecta.

import html
import json
import os
import queue
import secrets
import signal
import subprocess
import sys
import threading
import time
import urllib.request
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import parse_qs, urlparse

SERVER = os.environ.get("RLINK_SERVER", "https://carteleria.rlink.com.ar")
RUN_DIR = os.environ.get("RLINK_SETUP_RUN", "/run/rlink-setup")
PORT = int(os.environ.get("RLINK_SETUP_PORT", "80"))
SIMULAR = os.environ.get("RLINK_SETUP_SIMULAR") == "1"
LOG_FILE = "/var/log/rlink-setup.log"
FORCE_FILES = ["/boot/firmware/rlink-setup", "/boot/rlink-setup"]
WIFI_FILES = ["/boot/firmware/rlink-wifi.txt", "/boot/rlink-wifi.txt"]
CAPTIVE_CONF = "/etc/NetworkManager/dnsmasq-shared.d/rlink-captive.conf"
HOTSPOT = "rlink-hotspot"
RESCUE = "RLINK-SETUP"  # red de rescate (etapa 3): no cuenta como "configurada"
IFACE = "wlan0"
AP_IP = "10.42.0.1"  # la que usa NetworkManager en modo compartido
FORCED_TIMEOUT = 15 * 60
CABLE_CHECK_EVERY = 30
# Sin 0/O ni 1/I: se leen de la pantalla y se tipean en un celular.
ALPHABET = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789"

MESSAGES = {
    "clave": "la clave es incorrecta",
    "no_encontrada": "la Pi no encuentra esa red (¿está lejos o apagada?)",
    "sin_internet": "se conecta, pero no llega a internet",
    "no_conecta": "no se pudo conectar",
}


def log(msg):
    line = time.strftime("%Y-%m-%d %H:%M:%S ") + msg
    print(line, flush=True)
    if not SIMULAR:
        try:
            with open(LOG_FILE, "a", encoding="utf-8") as f:
                f.write(line + "\n")
        except OSError:
            pass


def run(args, timeout=60):
    try:
        p = subprocess.run(args, capture_output=True, text=True, timeout=timeout)
        return p.returncode, (p.stdout + p.stderr).strip()
    except (OSError, subprocess.TimeoutExpired) as e:
        return 1, str(e)


def split_nmcli(line):
    """nmcli -t separa con ':' y escapa los ':' del valor como '\\:'."""
    fields, cur, esc = [], "", False
    for ch in line:
        if esc:
            cur += ch
            esc = False
        elif ch == "\\":
            esc = True
        elif ch == ":":
            fields.append(cur)
            cur = ""
        else:
            cur += ch
    fields.append(cur)
    return fields


class State:
    def __init__(self):
        self.lock = threading.Lock()
        self.version = 0
        self.phase = "buscando"  # buscando, esperando, conectando, listo
        self.ap_ssid = "Rlink-" + "".join(secrets.choice(ALPHABET) for _ in range(4))
        self.ap_psk = "".join(secrets.choice(ALPHABET) for _ in range(8))
        self.networks = []
        self.target = ""
        self.error = ""
        self.forced = False
        self.last_activity = time.time()
        self.host = os.uname().nodename

    def update(self, **kw):
        with self.lock:
            for k, v in kw.items():
                setattr(self, k, v)
            self.version += 1

    def public(self):
        with self.lock:
            return {
                "version": self.version, "phase": self.phase, "ap_ssid": self.ap_ssid,
                "ap_psk": self.ap_psk, "target": self.target, "error": self.error,
                "forced": self.forced, "host": self.host,
            }


state = State()
actions = queue.Queue()
hotspot_active = False


def write_modo(modo):
    os.makedirs(RUN_DIR, exist_ok=True)
    tmp = os.path.join(RUN_DIR, "modo.tmp")
    with open(tmp, "w") as f:
        f.write(modo + "\n")
    os.chmod(tmp, 0o644)
    os.replace(tmp, os.path.join(RUN_DIR, "modo"))


def consume_force():
    forced = False
    for path in FORCE_FILES:
        if os.path.exists(path):
            forced = True
            try:
                os.remove(path)
            except OSError as e:
                log(f"no se pudo borrar {path}: {e}")
    return forced


def wifi_profiles():
    """Nombre → SSID de las redes Wi-Fi guardadas (sin la del modo configuración)."""
    rc, out = run(["nmcli", "-t", "-f", "NAME,TYPE", "connection", "show"])
    profiles = {}
    for line in out.splitlines() if rc == 0 else []:
        f = split_nmcli(line)
        if len(f) >= 2 and f[1] == "802-11-wireless" and f[0] != HOTSPOT:
            _, ssid = run(["nmcli", "-t", "-g", "802-11-wireless.ssid", "connection", "show", f[0]])
            profiles[f[0]] = ssid
    return profiles


def configured_networks():
    return [name for name, ssid in wifi_profiles().items() if ssid != RESCUE and name != RESCUE]


def server_ok(timeout=8):
    try:
        with urllib.request.urlopen(SERVER + "/up", timeout=timeout) as r:
            return r.status == 200
    except Exception:
        return False


def scan():
    rc, out = run(["nmcli", "-t", "-f", "SSID,SIGNAL,SECURITY", "device", "wifi", "list",
                   "ifname", IFACE, "--rescan", "no" if SIMULAR else "yes"], timeout=40)
    best = {}
    for line in out.splitlines() if rc == 0 else []:
        f = split_nmcli(line)
        if len(f) < 3 or not f[0] or f[0] == state.ap_ssid:
            continue
        signal_pct = int(f[1]) if f[1].isdigit() else 0
        if f[0] not in best or signal_pct > best[f[0]]["signal"]:
            best[f[0]] = {"ssid": f[0], "signal": signal_pct, "secure": f[2] not in ("", "--")}
    nets = sorted(best.values(), key=lambda n: -n["signal"])
    log(f"redes visibles: {len(nets)}")
    state.update(networks=nets)


def hotspot_up():
    global hotspot_active
    if SIMULAR:
        hotspot_active = True
        return True
    # Todo nombre resuelve a la Pi: así el celular detecta el portal y lo abre solo.
    os.makedirs(os.path.dirname(CAPTIVE_CONF), exist_ok=True)
    with open(CAPTIVE_CONF, "w") as f:
        f.write(f"# rlink-setup: portal cautivo, solo mientras está el modo configuración\naddress=/#/{AP_IP}\n")
    run(["nmcli", "connection", "delete", HOTSPOT])
    rc, out = run(["nmcli", "connection", "add", "type", "wifi", "ifname", IFACE, "con-name", HOTSPOT,
                   "autoconnect", "no", "ssid", state.ap_ssid,
                   "802-11-wireless.mode", "ap", "802-11-wireless.band", "bg",
                   "ipv4.method", "shared", "ipv6.method", "disabled",
                   "wifi-sec.key-mgmt", "wpa-psk", "wifi-sec.psk", state.ap_psk,
                   "wifi-sec.proto", "rsn", "wifi-sec.pairwise", "ccmp", "wifi-sec.group", "ccmp"])
    if rc != 0:
        log(f"no se pudo crear el hotspot: {out}")
        return False
    rc, out = run(["nmcli", "--wait", "30", "connection", "up", HOTSPOT], timeout=45)
    if rc != 0:
        log(f"no se pudo levantar el hotspot: {out}")
        return False
    hotspot_active = True
    log(f"emitiendo {state.ap_ssid}")
    return True


def hotspot_down():
    global hotspot_active
    if not SIMULAR:
        log("Bajando hotspot (nmcli connection down)...")
        rc, out = run(["nmcli", "connection", "down", HOTSPOT], timeout=20)
        if rc != 0:
            log(f"  advertencia (down): {out[:100]}")
        log("Borrando conexión de hotspot...")
        rc, out = run(["nmcli", "connection", "delete", HOTSPOT])
        if rc != 0:
            log(f"  advertencia (delete): {out[:100]}")
        try:
            os.remove(CAPTIVE_CONF)
            log("Borrado archivo de portal cautivo")
        except FileNotFoundError:
            pass
        except Exception as e:
            log(f"  error al borrar {CAPTIVE_CONF}: {e}")
    if hotspot_active:
        log("dejó de emitir")
    hotspot_active = False


def classify(out):
    low = out.lower()
    if "secrets were required" in low or "802-11-wireless-security" in low or "psk" in low:
        return "clave"
    if "no network with ssid" in low or "not found" in low:
        return "no_encontrada"
    return "no_conecta"


def connect(ssid, psk):
    """Crea un perfil para la red y lo prueba. Devuelve None si anda, o el motivo si no."""
    if SIMULAR:
        time.sleep(3)
        return "clave" if psk == "malaclave" else None

    name = ("rlink-" + ssid)[:60]
    before = wifi_profiles()
    run(["nmcli", "connection", "delete", name])
    cmd = ["nmcli", "connection", "add", "type", "wifi", "ifname", IFACE, "con-name", name,
           "ssid", ssid, "autoconnect", "yes", "connection.autoconnect-priority", "10"]
    if psk:
        cmd += ["wifi-sec.key-mgmt", "wpa-psk", "wifi-sec.psk", psk]
    rc, out = run(cmd)
    if rc != 0:
        log(f"no se pudo crear el perfil: {out}")
        return "no_conecta"
    rc, out = run(["nmcli", "--wait", "45", "connection", "up", name], timeout=60)
    reason = None
    if rc != 0:
        reason = classify(out)
        log(f"no conectó a la red elegida ({reason}): {out[:200]}")
    else:
        deadline = time.time() + 30
        while not server_ok() and time.time() < deadline:
            time.sleep(3)
        if not server_ok():
            reason = "sin_internet"
    if reason:
        run(["nmcli", "connection", "delete", name])
        return reason
    # La red nueva anda: los perfiles viejos de la misma red (con otra clave) sobran.
    for old, old_ssid in before.items():
        if old != name and old_ssid == ssid:
            run(["nmcli", "connection", "delete", old])
            log(f"borrado el perfil viejo {old}")
    return None


def try_wifi_file():
    for path in WIFI_FILES:
        if not os.path.exists(path):
            continue
        data = {}
        try:
            with open(path, encoding="utf-8-sig") as f:
                for line in f:
                    if "=" in line:
                        k, v = line.split("=", 1)
                        data[k.strip().lower()] = v.strip()
        except OSError as e:
            log(f"no se pudo leer {path}: {e}")
        try:
            os.remove(path)  # tiene una clave: no queda en la SD
        except OSError:
            pass
        ssid = data.get("ssid", "")
        if not ssid:
            log(f"{path} sin ssid=")
            continue
        log(f"probando la red de {path}")
        state.update(phase="conectando", target=ssid, error="")
        reason = connect(ssid, data.get("clave", data.get("password", "")))
        if reason is None:
            return True
        state.update(phase="buscando", error=f"{ssid}: {MESSAGES[reason]}")
    return False


def finish(why):
    log(f"listo: {why}")
    state.update(phase="listo", error="")
    time.sleep(5)  # que la pantalla y el celular alcancen a mostrar "listo"
    if not SIMULAR:
        log("ESCRIBIENDO MODO KIOSK...")
        write_modo("kiosk")
        log("MODO KIOSK ESCRITO EXITOSAMENTE")
        # Verificación: leer de vuelta para confirmar
        try:
            with open(os.path.join(RUN_DIR, "modo"), "r") as f:
                modo_verificado = f.read().strip()
            log(f"VERIFICACIÓN: modo contiene: '{modo_verificado}'")
        except Exception as e:
            log(f"ERROR AL VERIFICAR: {e}")


def leave_forced():
    """Forzado y nadie lo usó: vuelve la red de siempre (NetworkManager se reconecta solo)."""
    log("forzado sin uso por 15 min: vuelve al kiosco con la red guardada")
    hotspot_down()
    write_modo("kiosk")


# ---------------------------------------------------------------- páginas

