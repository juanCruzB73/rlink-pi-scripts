# Servicio que corre install.sh UNA SOLA VEZ al primer boot
# Se deshabilita a sí mismo después de ejecutar

[Unit]
Description=Rlink installation (runs once)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# El script de instalación debe estar en /tmp o /root
ExecStart=/tmp/rlink-install.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
