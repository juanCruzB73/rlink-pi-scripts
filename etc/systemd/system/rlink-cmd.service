# /etc/systemd/system/rlink-cmd.service — agente de comandos MQTT para la Pi.
#
# Escucha pi/<agent_key>/cmd y pi/all/cmd, ejecuta comandos whitelistados (update, reboot,
# restart-chromium, redownload-media, ping) y publica el ack. Ver /usr/local/bin/rlink-cmd.
#
# Instalar:  sudo systemctl daemon-reload && sudo systemctl enable --now rlink-cmd
# Log:       journalctl -u rlink-cmd -f

[Unit]
Description=rlink-cmd: agente de comandos MQTT
Wants=network-online.target rlink-reporte.service
After=network-online.target rlink-reporte.service

[Service]
Type=simple
Environment=RLINK_MQTT_HOST=carteleria.rlink.com.ar
Environment=RLINK_MQTT_PORT=1883
Environment=RLINK_SCRIPTS_DIR=/opt/rlink-scripts
ExecStart=/usr/local/bin/rlink-cmd
Restart=always
RestartSec=10
Nice=10
# mosquitto_sub dentro de un pipe no responde rápido a SIGTERM; bajamos el timeout y dejamos que
# systemd mande SIGKILL al cgroup en 5s en vez de esperar los 90s default.
TimeoutStopSec=5
KillMode=mixed
SendSIGKILL=yes

[Install]
WantedBy=multi-user.target
